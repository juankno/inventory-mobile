{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://surtido-api.vercel.app/api/v1",
        "EXPO_PUBLIC_USE_MOCK_API": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://surtido-api.vercel.app/api/v1",
        "EXPO_PUBLIC_USE_MOCK_API": "false"
      }
    }
  }
}
