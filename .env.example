# URL base de la API (sin la barra final).
# - Producción: https://surtido-api.vercel.app/api/v1
# - Backend local en el emulador de Android: http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL=https://surtido-api.vercel.app/api/v1

# Modo demostración: la app usa una API simulada en memoria (cualquier correo y
# contraseña sirven). Cámbialo a false cuando el backend tenga todos los endpoints.
EXPO_PUBLIC_USE_MOCK_API=true

# Rutas que ya responde el backend aunque el modo demostración siga activo,
# separadas por comas. Agrega cada ruta cuando se despliegue; por ejemplo,
# /auth/password-reset y luego /products, /movements e /inventory.
EXPO_PUBLIC_REAL_API_ROUTES=/auth/login,/auth/register
