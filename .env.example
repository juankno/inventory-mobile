# URL base de la API (sin la barra final). En el emulador de Android, localhost es 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Modo demostración: la app usa una API simulada en memoria (cualquier correo y
# contraseña sirven). Cámbialo a false cuando el backend tenga los endpoints.
EXPO_PUBLIC_USE_MOCK_API=true
